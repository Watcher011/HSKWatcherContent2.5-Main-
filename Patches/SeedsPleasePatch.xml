<?xml version="1.0" encoding="utf-8"?>
<Patch>


	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>SeedsPlease</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs</xpath>
					<value>
						<SeedsPlease.SeedDef ParentName="SeedBase">
							<defName>Spices_seeds</defName>
							<label>Spices seeds</label>
							<sources>
								<li>Plant_Spices</li>
							</sources>
							<graphicData>
								<texPath>Things/Plant/Seed</texPath>
								<drawSize>(1)</drawSize>
							</graphicData>
							 <statBases>
                                <MarketValue>9</MarketValue>
                             </statBases>
						</SeedsPlease.SeedDef>
				
						<RecipeDef ParentName="ExtractSeed">
							<defName>ExtractSpices</defName>
							<label>Extraction of Spices seeds</label>
							<description>Extraction of Spices seeds</description>
							<ingredients>
								<li>
									<filter>
										<thingDefs>
											<li>RawSpices</li>
										</thingDefs>
									</filter>
									<count>4</count>
								</li>
							</ingredients>
							<fixedIngredientFilter>
								<thingDefs>
									<li>RawSpices</li>
								</thingDefs>
							</fixedIngredientFilter>
							<products>
								<Spices_seeds>3</Spices_seeds>
							</products>
						</RecipeDef>
				
		
					</value>
				</li>				
			</operations>
		</match>
	</Operation>
</Patch>