<?xml version="1.0" encoding="utf-8" ?>
<Defs>


	<ThingDef ParentName="MealBase">
		<defName>DruFungus</defName>
		<label>Dried Mushrooms</label>
        <description>Dried mushrooms are a food product with a distinctive aroma and flavor, obtained by drying fresh edible mushrooms. After pre-soaking, dried mushrooms can be used in a wide variety of culinary applications, such as soups, stews, solyanka, sauces, pie fillings, and mushroom caviar.</description>
		<graphicData>
			<texPath>Things/Item/Meal/DruFungus</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<thingCategories>
			<li>BasicPlantFoodRaw</li>
		</thingCategories>
		<statBases>
			<DeteriorationRate>12</DeteriorationRate>
			<MarketValue>3</MarketValue>
			<Bulk>0.05</Bulk>
			<Mass>0.02</Mass>
			<WorkToMake>1500</WorkToMake>
			<Nutrition>0.18</Nutrition>
		</statBases>
		<stackLimit>75</stackLimit>
		<ingestible>
			<preferability>MealAwful</preferability>
			<ingestEffect>EatVegetarian</ingestEffect>
			<ingestSound>RawVegetable_Eat</ingestSound>
			<maxNumToIngestAtOnce>4</maxNumToIngestAtOnce>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>80</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>
	

<ThingDef ParentName="MealBase">
		<defName>DruFish</defName>
		<label>Dried Salted Fish</label>
        <description>The process consists of two stages: salting and drying. Salting is essential for products without heat treatment: the salt will kill any parasites present in the fish and slow down the decomposition process.</description>
		<graphicData>
			<texPath>Things/Item/Meal/DruFish</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<thingCategories>
			<li>MeatRaw</li>
		</thingCategories>
		<statBases>
			<DeteriorationRate>8</DeteriorationRate>
			<MarketValue>5</MarketValue>
			<Bulk>0.05</Bulk>
			<Mass>0.02</Mass>
			<WorkToMake>1500</WorkToMake>
			<Nutrition>0.18</Nutrition>
		</statBases>
		<stackLimit>75</stackLimit>
		<ingestible>
			<preferability>MealAwful</preferability>
			 <ingestEffect>EatMeat</ingestEffect>
			 <ingestSound>RawMeat_Eat</ingestSound>
			<maxNumToIngestAtOnce>4</maxNumToIngestAtOnce>
			<tasteThought>HadGFish</tasteThought>
			<chairSearchRadius>25</chairSearchRadius>
		</ingestible>
		<comps>
			<li Class="CompProperties_Rottable">
				<daysToRotStart>40</daysToRotStart>
				<rotDestroys>true</rotDestroys>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="MealBase">
		<defName>DruFishPlastic</defName>
		<label>Dried salted fish in packaging</label>
        <description>The process consists of three stages: salting, drying, and packaging. Salting is essential for products without heat treatment: the salt will kill any parasites present in the fish and slow down the decomposition process. Once packaged in plastic, it can be stored almost indefinitely.</description>
		<graphicData>
			<texPath>Things/Item/Meal/DruFishplastic</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<thingCategories>
			<li>MeatRaw</li>
		</thingCategories>
		<statBases>
			<DeteriorationRate>0.1</DeteriorationRate>
			<MarketValue>12</MarketValue>
			<Bulk>0.05</Bulk>
			<Mass>0.02</Mass>
			<WorkToMake>1500</WorkToMake>
			<Nutrition>0.48</Nutrition>
		</statBases>
		<stackLimit>75</stackLimit>
		<ingestible>
			 <preferability>MealSimple</preferability>
			 <ingestEffect>EatMeat</ingestEffect>
			 <ingestSound>RawMeat_Eat</ingestSound>
			<maxNumToIngestAtOnce>4</maxNumToIngestAtOnce>
			<tasteThought>HadGFish</tasteThought>
			<chairSearchRadius>25</chairSearchRadius>
		</ingestible>
			<allowedArchonexusCount>40</allowedArchonexusCount>
		<thingSetMakerTags>
		<li>HSKhumanitarianSuppliesTierOne</li>
		</thingSetMakerTags>
	</ThingDef>
	
	<ThingDef ParentName="MealBeverage">
    <defName>MealFishAndBeer</defName>
   <label>Beer with Dried Fish</label>
    <description>Beer and fish are made for each other.</description>
	 <descriptionHyperlinks>
      <HediffDef>AlcoholHigh</HediffDef>
      <HediffDef>AlcoholTolerance</HediffDef>
      <HediffDef>Hangover</HediffDef>
      <HediffDef>AlcoholAddiction</HediffDef>
      <HediffDef>Cirrhosis</HediffDef>
      <HediffDef>ChemicalDamageModerate</HediffDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Meal/FishAndBeer</texPath>
    <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	 <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <statBases>
      <MarketValue>10</MarketValue>
      <WorkToMake>300</WorkToMake>
	   <Mass>0.3</Mass>
      <Flammability>0.5</Flammability>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
	  <tasteThought>HadGFishAndBear</tasteThought>
	  <chairSearchRadius>25</chairSearchRadius>
	  <joyKind>Gluttonous</joyKind>
      <joy>0.20</joy>
	   <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholHigh</hediffDef>
          <severity>0.03</severity>
          <toleranceChemical>Alcohol</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholTolerance</hediffDef>
          <severity>0.003</severity>
          <divideByBodySize>true</divideByBodySize>
          <multiplyByGeneToleranceFactors>true</multiplyByGeneToleranceFactors>
        </li>
      </outcomeDoers>
    </ingestible>
	 <comps>
      <li Class="CompProperties_Drug">
        <chemical>Alcohol</chemical>
        <addictiveness>0.010</addictiveness>
        <minToleranceToAddict>0.25</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>10</listOrder>
      </li>
    </comps>
	<allowedArchonexusCount>40</allowedArchonexusCount>
		<thingSetMakerTags>
		<li>HSKhumanitarianSuppliesTierOne</li>
		</thingSetMakerTags>
  </ThingDef>
  
