<Defs>

  <!-- ============================================ -->
    <!-- THINGDEF: Ocellus с CE бронёй               -->
    <!-- ============================================ -->
    <ThingDef ParentName="AnimalThingBase">
        <defName>Ocellus</defName>
        <label>Ocellus Parasite</label>
        <description>The link penetrates the eye socket and fuses with the brain, completely dominating the body. The host remains safe, but is unable to control themselves, watching as the parasite uses their hands on their loved ones. The eye glows with a pulsating light, and threads writhe beneath the skin. The creature studies the victim's behavior and copies it. Even death does not free it—the parasite leaves the corpse through the eye socket in search of a new host.</description>
        <statBases>
            <Mass>0.5</Mass>
            <MoveSpeed>8.8</MoveSpeed>
            <ComfyTemperatureMin>-5</ComfyTemperatureMin>
            <ComfyTemperatureMax>50</ComfyTemperatureMax>
            <MarketValue>200</MarketValue>
            <LeatherAmount>0</LeatherAmount>
            <MeatAmount>0</MeatAmount>
            <ImmunityGainSpeed>3</ImmunityGainSpeed>
            <MeleeDodgeChance>0.35</MeleeDodgeChance>
            <MeleeCritChance>0.15</MeleeCritChance>
            <SmokeSensitivity>0.5</SmokeSensitivity>
            <GermResistance>0.7</GermResistance>
            <GermContainment>0.01</GermContainment>
            <FilthRate>4</FilthRate>
            <ToxicResistance>0.95</ToxicResistance>
            <Wildness>0.85</Wildness>
            <!-- CE броня -->
            <ArmorRating_Sharp>3.5</ArmorRating_Sharp>
            <ArmorRating_Blunt>5.2</ArmorRating_Blunt>
            <ArmorRating_Heat>0.5</ArmorRating_Heat>
            <!-- CE дополнительные статы -->
            <MeleeParryChance>0.1</MeleeParryChance>
            <Suppressability>0.3</Suppressability>
            <NightVisionEfficiency>0.8</NightVisionEfficiency>
        </statBases>
        <tools>
            <li Class="CombatExtended.ToolCE">
                <label>mouth</label>
                <capacities>
                    <li>PlagueBite</li>
                </capacities>
                <power>4</power>
                <cooldownTime>1.2</cooldownTime>
                <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
                <armorPenetrationSharp>1.5</armorPenetrationSharp>
                <armorPenetrationBlunt>2.0</armorPenetrationBlunt>
            </li>
            <li Class="CombatExtended.ToolCE">
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>2</power>
                <cooldownTime>1.65</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <chanceFactor>0.2</chanceFactor>
                <armorPenetrationBlunt>1.0</armorPenetrationBlunt>
            </li>
        </tools>
        <butcherProducts>
            <Chitin>1</Chitin>
        </butcherProducts>
        <race>
            <body>BeetleLike</body>
            <herdMigrationAllowed>false</herdMigrationAllowed>
            <baseHungerRate>0.68</baseHungerRate>
            <baseBodySize>0.16</baseBodySize>
            <baseHealthScale>0.16</baseHealthScale>
            <useMeatFrom>Megaspider</useMeatFrom>
            <foodType>Plant, OmnivoreAnimal, AnimalProduct, Corpse</foodType>
            <fleshType>Insectoid</fleshType>
            <bloodDef>Filth_BloodInsect</bloodDef>
            <petness>0</petness>
            <manhunterOnTameFailChance>0.01</manhunterOnTameFailChance>
            <manhunterOnDamageChance>0</manhunterOnDamageChance>
            <lifeExpectancy>3</lifeExpectancy>
            <lifeStageAges>
                <li>
                    <def>EusocialInsectLarva</def>
                    <minAge>0</minAge>
                </li>
                <li>
                    <def>EusocialInsectJuvenile</def>
                    <minAge>0.03</minAge>
                </li>
                <li>
                    <def>EusocialInsectAdult</def>
                    <minAge>0.13</minAge>
                    <soundWounded>Pawn_Megascarab_Wounded</soundWounded>
                    <soundDeath>Pawn_Megascarab_Death</soundDeath>
                    <soundCall>Pawn_Megascarab_Call</soundCall>
                    <soundAngry>Pawn_Megascarab_Angry</soundAngry>
                </li>
            </lifeStageAges>
            <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
            <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
            <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
            <soundEating>Insectoid_Eat</soundEating>
        </race>
        <modExtensions>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
                <bodyShape>QuadrupedLow</bodyShape>
            </li>
            <li Class="SK.DestroyCorpseExtension" />
            <li Class="SK.DevourerAnimalExtension">
                <things>
                    <li>food</li>
                </things>
            </li>
        </modExtensions>
    <comps>
		<li Class="CombatExtended.CompProperties_ArmorDurability">
				<Durability>325</Durability>
				<Regenerates>true</Regenerates>
				<RegenInterval>60</RegenInterval>
				<RegenValue>5</RegenValue>
				<MinArmorPct>0.75</MinArmorPct>
		</li>
    </comps>
    </ThingDef>

