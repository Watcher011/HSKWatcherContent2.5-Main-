<RecipeDef>
		<defName>MakeBallisticPlateI</defName>
		<label>Craft Ballistic PlateI</label>
		<description>Crafts Ballistic Plate(Metallic). Produces 1.</description>
		<jobString>Crafting a Ballistic Plate.</jobString>
		<workAmount>9000</workAmount>
		<workSpeedStat>SmithingSpeed</workSpeedStat>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Interact_Repair</soundWorking>
		<recipeUsers>
			<li>FueledSmithy</li>
			<li>ElectricSmithy</li>
		</recipeUsers>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Metallic</li>
					</categories>
				</filter>
				<count>50</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>Textiles</li>
					</categories>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
				<li>BTextiles</li>
				<li>HTextiles</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<BallisticPlateI>1</BallisticPlateI>    
		</products>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<unfinishedThingDef>UnfinishedMetallicApparel</unfinishedThingDef>
		<researchPrerequisite>Armor_B2</researchPrerequisite>
	</RecipeDef>
	
	
