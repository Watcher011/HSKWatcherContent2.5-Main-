<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	

	<!-- Compaste -->
	<RecipeDef>
		<defName>MakePrimitiveCompaste</defName>
		<label>Craft primitive compound paste</label>
		<description>Craft bottles of primitive compound paste, used in a wide variety of clothing. Produces 20.</description>
		<jobString>Crafting compound paste.</jobString>
		<workSpeedStat>DrugCookingSpeed</workSpeedStat>
		<workAmount>3200</workAmount>
		<effectWorking>Smith</effectWorking>
		<soundWorking>Recipe_CookMeal</soundWorking>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Chemfuel</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Amber</li>
					</thingDefs>
				</filter>
				<count>15</count>
			</li>
		</ingredients>
		<products>
			<Compaste>20</Compaste>
		</products>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Chemfuel</li>
				<li>Amber</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>Chemfuel</li>
				<li>Amber</li>
			</thingDefs>
		</defaultIngredientFilter>
		<skillRequirements>
			<Crafting>5</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<!--<li>DrugLab</li>
			<li>meditable</li>-->
			<li>FabricationBench</li>
		</recipeUsers>
		
	</RecipeDef>
	
