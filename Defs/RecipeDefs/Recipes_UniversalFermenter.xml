				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
			<li>Milk</li>
			<li>Chocolate</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<IceCreamchocolate>2</IceCreamchocolate>
		</products>
	</RecipeDef>
	
