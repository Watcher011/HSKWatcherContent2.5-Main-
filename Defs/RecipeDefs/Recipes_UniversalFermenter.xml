	<RecipeDef ParentName="Make_CoffeeBase" Class="UniversalFermenterSK.RecipeDef_UF">
		<defName>Make_CupDecaffeinatedCoffee</defName>
	    <label>Decaffeinated Coffee x2</label>
        <description>"Officially approved by the Imperial Ministry of Health as 'the least harmful way to lose your temper with life'. It undergoes 12 stages of chemical processing, during which the beans are carefully stripped of everything that could bring even a drop of joy to this cruel world. Ideal for:Colonies where alcohol has already been banned (by order of a nervous security chief).Former coffee drinkers who have 'pulled themselves together' (and now hate everyone around them).Fake productivity during night shifts"</description>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>GroundCoffee</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
		</ingredients>
		<products>
			<CupDecaffeinatedCoffee>2</CupDecaffeinatedCoffee>
		</products>
	</RecipeDef>

	<RecipeDef ParentName="Make_CoffeeBase" Class="UniversalFermenterSK.RecipeDef_UF">
