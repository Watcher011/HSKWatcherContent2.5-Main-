<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ThingDef ParentName="UniversalFermenterBase" Class="UniversalFermenterSK.ThingDef_UF">
		<defName>IcecreamBasin</defName>
		<label>Ice cream machine</label>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			 <graphicClass>Graphic_Multi</graphicClass>
	  <shaderType>CutoutComplex</shaderType>
	  <texPath>Things/Machin/Icecream_MachinB</texPath>
	  <drawSize>(2.4,2.4)</drawSize>
	  <drawRotated>true</drawRotated>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<size>(1,1)</size>
		<uiIconPath>Things/Machin/Icecream_MachinB_UI</uiIconPath>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsProduction</li>
		</thingCategories>
		<fillPercent>0.45</fillPercent>
		<pathCost>60</pathCost>
		<statBases>
			<WorkToBuild>800</WorkToBuild>
			<Mass>10</Mass>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
		</statBases>
		<description>*"Approved by the Ministry of Public Enjoyment as 'the most effective remedy against seditious thoughts'. Guaranteed to distract colonists from such unnecessary questions as 'why are we eating nut paste again' or 'who is that shooting on the perimeter'.Each cone contains a carefully calibrated dose of sugar, synthetic flavors and mild antidepressants. A built-in mood sensor automatically adds extra chocolate when it detects an elevated level of 'unhealthy thoughts' in the client."*</description>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>40</costStuffCount>
		<costList>
			<Mechanism>3</Mechanism>
			<Glass>15</Glass>
		</costList>
		<building>
			<uninstallWork>650</uninstallWork>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
				<li Class="CompProperties_Glower">
				<glowRadius>3</glowRadius>
				<glowColor>(117,77,213,0)</glowColor>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
				<soundPowerOn>Power_OnSmall</soundPowerOn>
				<soundPowerOff>Power_OffSmall</soundPowerOff>
			</li>
		</comps>
		<tickerType>Rare</tickerType>
		<rotatable>true</rotatable>
		<designationCategory>Production</designationCategory>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>Food_C1</li>
		</researchPrerequisites>
		<!-- ThingDef_UF fields -->
		<showProductIcon>false</showProductIcon>
		<barOffset>(0.0, -0.18)</barOffset>
		<barScale>(1.1, 1.1)</barScale>
		<slotsCount>4</slotsCount>
	</ThingDef>
	
	
