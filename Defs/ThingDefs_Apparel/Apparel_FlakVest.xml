			<ArmorRating_Blunt>12</ArmorRating_Blunt>
			<ArmorRating_Heat>0</ArmorRating_Heat>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.04</MoveSpeed>
			<Suppressability>-0.06</Suppressability>
		</equippedStatOffsets>
		<generateCommonality>0.2</generateCommonality>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryBasic</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags> 
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(1.0,1.0,1.0)</only>
				</li>
			</options>
		</colorGenerator>
		<thingCategories>
			 <li>VestsCat</li>
		</thingCategories>
		<generateAllowChance>0.1</generateAllowChance>
	</ThingDef>
	
	
