<Defs>

 <ThingDef ParentName="ApparelNoQualityBase">
		<defName>BallisticPlateI</defName>
		<label>Ballistic Plate(Metallic)</label>
		<description>A stamped, heat-treated steel plate. It can handle pistol-caliber fire, but a burst of machine gun fire will only crack and heat up your chest.</description>
		<graphicData>
			<texPath>Things/Apparel/BallisticPlate/BPI</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			
		</graphicData>		
