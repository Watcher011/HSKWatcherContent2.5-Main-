			<wornGraphicPath>Things/Apparel/Helmets/MaxTac</wornGraphicPath>
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>IndustrialMilitaryAdvanced</li>
				<li>SectarianMedium</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<useDeflectMetalEffect>true</useDeflectMetalEffect>
			<parentTagDef>ApparelHead</parentTagDef>
		</apparel>
		<thingCategories>
			<li>MediumHelmetsCat</li>
			<li>Setmarinearmor</li>
		</thingCategories>
		<recipeMaker>
			<researchPrerequisite>Fabrication</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
	
</Defs>
