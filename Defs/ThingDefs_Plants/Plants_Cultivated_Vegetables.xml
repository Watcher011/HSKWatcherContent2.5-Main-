<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef Name="SpicesPlant" ParentName="PlantBase">
		<defName>Plant_Spices</defName>
		<label>Blazepepper plant</label>
		<description>A low-growing perennial shrub adapted to arid and poor soils. Its leaves have evolved into small waxy spines to minimize moisture evaporation. The bright red fruits resemble elongated pods and hang from thorny branches.</description>
		<statBases>
			<MaxHitPoints>85</MaxHitPoints>
			<Nutrition>0.05</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/Spices</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<pathCost>14</pathCost>
		<ingestible/>
		<plant>
			<pollution>Any</pollution>
			<dieFromToxicFallout>False</dieFromToxicFallout>
			<immatureGraphicPath>Things/Plant/Spices_Immature</immatureGraphicPath>
			<fertilitySensitivity>0.1</fertilitySensitivity>
			<dieIfLeafless>true</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>RawSpices</harvestedThingDef>
			<harvestYield>11</harvestYield>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
			</sowTags>
			<topWindExposure>0.1</topWindExposure>
			<growDays>7.8</growDays>
			<visualSizeRange>1.0~1.5</visualSizeRange>
			<wildOrder>2</wildOrder>
			<purpose>Food</purpose>
			<humanFoodPlant>true</humanFoodPlant>
			<dieFromToxicFallout>False</dieFromToxicFallout>
			<wildBiomes Inherit="False">
				<BorealForest>0.04</BorealForest>
				<Tundra>0.03</Tundra>
				<ColdBog>0.02</ColdBog>
				<TemperateForest>0.06</TemperateForest>
				<TemperateSwamp>0.05</TemperateSwamp>
				<TropicalRainforest>0.06</TropicalRainforest>
				<TropicalSwamp>0.05</TropicalSwamp>
				<AridShrubland>0.04</AridShrubland>
				<BorealArchipelago>0.04</BorealArchipelago>
				<TundraArchipelago>0.02</TundraArchipelago>
				<ColdBogArchipelago>0.01</ColdBogArchipelago>
				<TemperateArchipelago>0.05</TemperateArchipelago>
				<TemperateSwampArchipelago>0.05</TemperateSwampArchipelago>
				<TropicalArchipelago>0.05</TropicalArchipelago>
				<TropicalSwampArchipelago>0.05</TropicalSwampArchipelago>
			</wildBiomes>
		</plant>
		<tickerType>Normal</tickerType>
		<comps>
			<!--<li Class="CompProperties_Glower">
				<glowRadius>1</glowRadius>
				<glowColor>(128,5,100,0)</glowColor>
			</li>-->
			<li Class="HSK.Watcher.Content.CompProperties_PlantAllergySource">
				<hediffDef>PlantPollenAllergy</hediffDef>
				<severityContribution>0.10</severityContribution>
				<onlyMature>true</onlyMature>
				<radius>2.9</radius>
				<maxSeverity>1.0</maxSeverity>
				<severityPerTick>0.02</severityPerTick>
				<!-- Быстрее накапливается -->
				<decayPerTick>0.01</decayPerTick>
				<!-- Медленнее спадает -->
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="CavePlantBase">
		<defName>Mold</defName>
		<label>Mold</label>
		<description>A small brown mushroom typically found in caves. It smells like an old, dirty rag pulled from the stomach of a rotting muffalo - but it tastes surprisingly good when cooked. Dies when exposed to light.</description>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Beauty>2</Beauty>
			<BeautyOutdoors>2</BeautyOutdoors>
			<Nutrition>0.5</Nutrition>
		</statBases>
		<graphicData>
			<texPath>Things/Plant/Mold</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<selectable>true</selectable>
		<neverMultiSelect>false</neverMultiSelect>
		<pathCost>14</pathCost>
		<ingestible/>
		<plant>
			<fertilityMin>0.01</fertilityMin>
			<fertilitySensitivity>0.15</fertilitySensitivity>
			<growDays>40</growDays>
			<dieIfLeafless>true</dieIfLeafless>
			<harvestYield>20</harvestYield>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>Penicillin</harvestedThingDef>
			<maxMeshCount>4</maxMeshCount>
			<neverBlightable>true</neverBlightable>
			<visualSizeRange>1.4~1.7</visualSizeRange>
			<topWindExposure>0.05</topWindExposure>
			<wildClusterRadius>3</wildClusterRadius>
			<wildClusterWeight>5</wildClusterWeight>
			<purpose>Food</purpose>
			<pollution>Any</pollution>
		</plant>
		<comps>
			<li Class="CompProperties_Glower">
				<glowRadius>2.9</glowRadius>
				<glowColor>(10,50,64,0)</glowColor>
			</li>
			<li Class="HSK.Watcher.Content.CompProperties_PlantAllergySource">
				<hediffDef>ToxicSporeInhalation</hediffDef>
				<severityContribution>0.10</severityContribution>
				<!-- Опциональные параметры -->
				<onlyMature>false</onlyMature>
				<radius>2.9</radius>
				<maxSeverity>1.0</maxSeverity>
				<severityPerTick>0.04</severityPerTick>
				<!-- Быстрее накапливается -->
				<decayPerTick>0.01</decayPerTick>
				<!-- Медленнее спадает -->
			</li>
		</comps>
	</ThingDef>
</Defs>